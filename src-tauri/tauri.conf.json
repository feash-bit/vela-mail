{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vela",
  "version": "0.1.2",
  "identifier": "app.vela.mail",
  "mainBinaryName": "vela-mail",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vela",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#16161a"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "A fast, keyboard-first Gmail client",
    "longDescription": "Vela is a modern Gmail desktop client with a keyboard-first workflow, secure sign-in and safe email rendering.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "desktopTemplate": "../packaging/vela-mail.desktop"
      }
    },
    "publisher": "Vela"
  }
}
