{
  "name": "vela-mail",
  "private": true,
  "version": "0.1.2",
  "description": "Vela \u2014 a fast, keyboard-first Gmail desktop client for Linux",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:demo": "VITE_DEMO=1 tauri dev",
    "vite": "vite",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build",
    "build:appimage": "NO_STRIP=true tauri build --bundles appimage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.0",
    "@tauri-apps/api": "^2.12.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
